//@version=5
strategy("BTC/ETH Rebalancing Strategy", 
         shorttitle="BTC/ETH Rebal",
         overlay=false, 
         initial_capital=10000, 
         default_qty_type=strategy.cash,
         commission_type=strategy.commission.percent, 
         commission_value=0.1,
         slippage=5)

// ============================================================================
// CONFIGURATION
// ============================================================================

// Get second asset data (ETH if chart is BTC, or vice versa)
secondAsset = input.string("BINANCE:ETHUSDT", "Second Asset", group="Assets", 
                           tooltip="Enter the second asset symbol (e.g., BINANCE:ETHUSDT)")

// Portfolio allocation
asset1Weight = input.float(50.0, "Primary Asset Weight (%)", minval=0, maxval=100, step=5, group="Allocation")
asset2Weight = 100 - asset1Weight

// Rebalancing settings
rebalanceThreshold = input.float(5.0, "Rebalance Threshold (%)", minval=0.5, maxval=20, step=0.5, group="Rebalancing")

// ============================================================================
// GET SECOND ASSET PRICE
// ============================================================================

asset1Price = close
asset2Price = request.security(secondAsset, timeframe.period, close, lookahead=barmerge.lookahead_off)

// ============================================================================
// STATE TRACKING
// ============================================================================

var float asset1Qty = 0.0
var float asset2Qty = 0.0
var int rebalanceCount = 0
var float lastPortfolioValue = 0.0

// ============================================================================
// CALCULATIONS
// ============================================================================

// Calculate current portfolio value
asset1Value = asset1Qty * asset1Price
asset2Value = asset2Qty * asset2Price
portfolioValue = asset1Value + asset2Value

// Calculate current allocations (%)
currentAsset1Pct = portfolioValue > 0 ? (asset1Value / portfolioValue) * 100 : 0
currentAsset2Pct = portfolioValue > 0 ? (asset2Value / portfolioValue) * 100 : 0

// Check if drift exceeds threshold
asset1Drift = math.abs(currentAsset1Pct - asset1Weight)
asset2Drift = math.abs(currentAsset2Pct - asset2Weight)
needsRebalance = asset1Drift > rebalanceThreshold or asset2Drift > rebalanceThreshold

// ============================================================================
// INITIALIZE PORTFOLIO
// ============================================================================

if barstate.isfirst
    // Initial purchase
    initialAsset1Value = strategy.initial_capital * (asset1Weight / 100)
    initialAsset2Value = strategy.initial_capital * (asset2Weight / 100)
    
    asset1Qty := initialAsset1Value / asset1Price
    asset2Qty := initialAsset2Value / asset2Price
    
    lastPortfolioValue := strategy.initial_capital

// ============================================================================
// REBALANCING LOGIC
// ============================================================================

if needsRebalance and not barstate.isfirst
    // Calculate target values
    targetAsset1Value = portfolioValue * (asset1Weight / 100)
    targetAsset2Value = portfolioValue * (asset2Weight / 100)
    
    // Calculate new quantities
    newAsset1Qty = targetAsset1Value / asset1Price
    newAsset2Qty = targetAsset2Value / asset2Price
    
    // Determine trades
    asset1Trade = newAsset1Qty - asset1Qty
    asset2Trade = newAsset2Qty - asset2Qty
    
    // Update quantities
    asset1Qty := newAsset1Qty
    asset2Qty := newAsset2Qty
    
    // Increment counter
    rebalanceCount += 1
    
    // Visual marker
    bgcolor(color.new(color.blue, 90), title="Rebalance Event")

// ============================================================================
// VISUALIZATION
// ============================================================================

// Plot portfolio value
plot(portfolioValue, "Portfolio Value", color=color.new(color.green, 0), linewidth=2)
plot(strategy.initial_capital, "Initial Capital", color=color.new(color.gray, 50), linewidth=1, style=plot.style_line)

// Plot allocations
hline(asset1Weight, "Target Asset 1", color=color.new(color.blue, 70), linestyle=hline.style_dashed)
hline(asset2Weight, "Target Asset 2", color=color.new(color.orange, 70), linestyle=hline.style_dashed)

plot(currentAsset1Pct, "Current Asset 1 %", color=color.blue, linewidth=1)
plot(currentAsset2Pct, "Current Asset 2 %", color=color.orange, linewidth=1)

// Threshold bands
hline(asset1Weight + rebalanceThreshold, "Upper Band", color=color.new(color.red, 80), linestyle=hline.style_dotted)
hline(asset1Weight - rebalanceThreshold, "Lower Band", color=color.new(color.red, 80), linestyle=hline.style_dotted)

// ============================================================================
// STATISTICS DISPLAY
// ============================================================================

if barstate.islast
    var table infoTable = table.new(position.top_right, 2, 10, border_width=1, 
                                     bgcolor=color.new(color.black, 85), frame_color=color.gray)
    
    // Calculate returns
    totalReturn = ((portfolioValue - strategy.initial_capital) / strategy.initial_capital) * 100
    
    // Row 0: Header
    table.cell(infoTable, 0, 0, "📊 Portfolio Stats", bgcolor=color.new(color.blue, 70), 
               text_color=color.white, text_size=size.normal)
    table.cell(infoTable, 1, 0, "", bgcolor=color.new(color.blue, 70))
    
    // Row 1: Initial Capital
    table.cell(infoTable, 0, 1, "Initial Capital", text_color=color.gray)
    table.cell(infoTable, 1, 1, "$" + str.tostring(strategy.initial_capital, "#,###"), text_color=color.white)
    
    // Row 2: Current Value
    table.cell(infoTable, 0, 2, "Current Value", text_color=color.gray)
    table.cell(infoTable, 1, 2, "$" + str.tostring(portfolioValue, "#,###.##"), text_color=color.white)
    
    // Row 3: Total Return
    table.cell(infoTable, 0, 3, "Total Return", text_color=color.gray)
    returnColor = totalReturn >= 0 ? color.green : color.red
    table.cell(infoTable, 1, 3, str.tostring(totalReturn, "#.##") + "%", text_color=returnColor)
    
    // Row 4: Rebalances
    table.cell(infoTable, 0, 4, "Rebalances", text_color=color.gray)
    table.cell(infoTable, 1, 4, str.tostring(rebalanceCount), text_color=color.yellow)
    
    // Row 5: Separator
    table.cell(infoTable, 0, 5, "Current Allocation", bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(infoTable, 1, 5, "", bgcolor=color.new(color.gray, 85))
    
    // Row 6: Asset 1
    table.cell(infoTable, 0, 6, syminfo.ticker, text_color=color.gray)
    table.cell(infoTable, 1, 6, str.tostring(currentAsset1Pct, "#.#") + "%", text_color=color.blue)
    
    // Row 7: Asset 2
    table.cell(infoTable, 0, 7, "Asset 2", text_color=color.gray)
    table.cell(infoTable, 1, 7, str.tostring(currentAsset2Pct, "#.#") + "%", text_color=color.orange)
    
    // Row 8: Drift
    maxDrift = math.max(asset1Drift, asset2Drift)
    table.cell(infoTable, 0, 8, "Max Drift", text_color=color.gray)
    driftColor = maxDrift > rebalanceThreshold ? color.red : color.green
    table.cell(infoTable, 1, 8, str.tostring(maxDrift, "#.#") + "%", text_color=driftColor)

// ============================================================================
// LABELS FOR REBALANCING EVENTS
// ============================================================================

if needsRebalance and not barstate.isfirst
    labelText = "Rebalance #" + str.tostring(rebalanceCount) + "\n" + 
                syminfo.ticker + ": " + str.tostring(currentAsset1Pct, "#.#") + "% → " + str.tostring(asset1Weight, "#.#") + "%"
    
    label.new(bar_index, portfolioValue, labelText, 
              color=color.new(color.blue, 20), 
              textcolor=color.white,
              style=label.style_label_down, 
              size=size.small)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(needsRebalance, "Rebalance Alert", "Portfolio needs rebalancing!")

